{
  "name": "@hamicek/noex-client",
  "version": "0.2.1",
  "description": "TypeScript client SDK for @hamicek/noex-server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:stress": "vitest run --config vitest.config.stress.ts",
    "examples": "vitest run --config examples/vitest.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "ws": "^8.18.0",
    "@types/ws": "^8.5.0",
    "@hamicek/noex": "file:../../../../../tmp/noex-pack/hamicek-noex-0.1.0.tgz",
    "@hamicek/noex-store": "file:../noex-store",
    "@hamicek/noex-server": "file:../noex-server",
    "@hamicek/noex-rules": "file:../noex-rules",
    "@hamicek/noex-logic": "file:../noex-logic",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
